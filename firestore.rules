rules_version = '2';

// Movie Ladder's top-10 high-score leaderboards (see app/src/leaderboard.ts).
// Public read (anyone can view a leaderboard without signing in), a
// narrowly-shaped create (enforces the 3-letter-initials/bounded-score
// format the client actually writes), and no update/delete from the client
// at all -- scores are write-once. This does NOT verify a score was
// actually earned by real gameplay; there's no backend for this client-only
// game to check against. The score cap below is just a sanity ceiling
// against obviously-fake values, not real anti-cheat.
//
// One collection per difficulty mode (added 2026-08-08): `highscores` is
// regular mode -- keeping its original name so scores submitted before the
// modes existed stay on the board they were played under -- and
// `highscores_easy` is easy mode. Easy restricts the movie pool to
// well-known films, counts only three connection types, and names the
// connection category outright, so its scores aren't comparable to
// regular's and must not share a board. The shape rules are identical for
// both, so they're factored into validScore() rather than duplicated.
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore() {
      return request.resource.data.keys().hasOnly(['name', 'score', 'createdAt'])
             && request.resource.data.name is string
             && request.resource.data.name.size() > 0
             && request.resource.data.name.size() <= 3
             && request.resource.data.score is number
             && request.resource.data.score > 0
             && request.resource.data.score <= 1000000
             && request.resource.data.createdAt == request.time;
    }

    match /highscores/{scoreId} {
      allow read: if true;
      allow create: if validScore();
      allow update, delete: if false;
    }

    match /highscores_easy/{scoreId} {
      allow read: if true;
      allow create: if validScore();
      allow update, delete: if false;
    }
  }
}
